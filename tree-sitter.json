{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gitignore",
      "title": "Gitignore",
      "scope": "source.gitignore",
      "path": ".",
      "file-types": [".gitignore", "gitignore"],
      "injection-regex": "^gitignore$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for gitignore.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-gitignore"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
