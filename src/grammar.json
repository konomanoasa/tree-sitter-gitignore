{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gitignore",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "blank_line"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "pattern"
          }
        ]
      }
    },
    "line_ending": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_line_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "line_ending"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "trailing_carriage_return"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_eof"
            }
          ]
        }
      ]
    },
    "_end": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "trailing_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_suffix"
        }
      ]
    },
    "_suffix": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "ignored_suffix"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "ignored_suffix": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_ignored_start"
        },
        {
          "type": "SYMBOL",
          "name": "ignored_text"
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_suffix"
        }
      ]
    },
    "pattern": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_pattern_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "negation",
              "content": {
                "type": "SYMBOL",
                "name": "negation"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "glob_literal"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_glob_start"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "wildcard"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "recursive_wildcard"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "single_character"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "path_separator"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "escape"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "character_set"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "glob_literal": {
      "type": "SYMBOL",
      "name": "_literal"
    },
    "character_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "set_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "negation",
              "content": {
                "type": "SYMBOL",
                "name": "set_negation"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_set_item"
          }
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "set_close"
          }
        }
      ]
    },
    "_set_item": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_set_item_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "set_text"
            },
            {
              "type": "SYMBOL",
              "name": "escape"
            },
            {
              "type": "SYMBOL",
              "name": "character_range"
            },
            {
              "type": "SYMBOL",
              "name": "character_class"
            }
          ]
        }
      ]
    },
    "character_range": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_range_start"
        },
        {
          "type": "FIELD",
          "name": "lower",
          "content": {
            "type": "SYMBOL",
            "name": "_endpoint"
          }
        },
        {
          "type": "SYMBOL",
          "name": "range_operator"
        },
        {
          "type": "FIELD",
          "name": "upper",
          "content": {
            "type": "SYMBOL",
            "name": "_endpoint"
          }
        }
      ]
    },
    "_endpoint": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "range_character"
        },
        {
          "type": "SYMBOL",
          "name": "escape"
        }
      ]
    },
    "character_class": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_compound_open"
          },
          "named": false,
          "value": "["
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_class_open"
          },
          "named": false,
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "class_name"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_class_close"
          },
          "named": false,
          "value": ":"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_compound_close"
          },
          "named": false,
          "value": "]"
        }
      ]
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_blank_start"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_start"
    },
    {
      "type": "SYMBOL",
      "name": "_pattern_start"
    },
    {
      "type": "SYMBOL",
      "name": "_eof"
    },
    {
      "type": "SYMBOL",
      "name": "_glob_start"
    },
    {
      "type": "SYMBOL",
      "name": "_set_item_start"
    },
    {
      "type": "SYMBOL",
      "name": "comment_marker"
    },
    {
      "type": "SYMBOL",
      "name": "comment_text"
    },
    {
      "type": "SYMBOL",
      "name": "negation"
    },
    {
      "type": "SYMBOL",
      "name": "_literal"
    },
    {
      "type": "SYMBOL",
      "name": "wildcard"
    },
    {
      "type": "SYMBOL",
      "name": "recursive_wildcard"
    },
    {
      "type": "SYMBOL",
      "name": "single_character"
    },
    {
      "type": "SYMBOL",
      "name": "path_separator"
    },
    {
      "type": "SYMBOL",
      "name": "escape"
    },
    {
      "type": "SYMBOL",
      "name": "set_open"
    },
    {
      "type": "SYMBOL",
      "name": "set_negation"
    },
    {
      "type": "SYMBOL",
      "name": "set_text"
    },
    {
      "type": "SYMBOL",
      "name": "set_close"
    },
    {
      "type": "SYMBOL",
      "name": "_range_start"
    },
    {
      "type": "SYMBOL",
      "name": "range_character"
    },
    {
      "type": "SYMBOL",
      "name": "range_operator"
    },
    {
      "type": "SYMBOL",
      "name": "_compound_open"
    },
    {
      "type": "SYMBOL",
      "name": "_compound_close"
    },
    {
      "type": "SYMBOL",
      "name": "_class_open"
    },
    {
      "type": "SYMBOL",
      "name": "class_name"
    },
    {
      "type": "SYMBOL",
      "name": "_class_close"
    },
    {
      "type": "SYMBOL",
      "name": "trailing_space"
    },
    {
      "type": "SYMBOL",
      "name": "trailing_carriage_return"
    },
    {
      "type": "SYMBOL",
      "name": "_ignored_start"
    },
    {
      "type": "SYMBOL",
      "name": "ignored_text"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}