    "_incomplete_escape_outcome": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_incomplete_escape"
      },
      "named": true,
      "value": "incomplete_escape"
    },
    "_incomplete_escape_issue": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_incomplete_escape_outcome"
      },
      "named": true,
      "value": "incomplete_syntax"
    }
  },
