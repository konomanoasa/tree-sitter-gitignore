{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gitignore",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "blank_line"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "pattern"
          }
        ]
      }
    },
    "line_ending": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_line_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "line_ending"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "trailing_carriage_return"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_eof"
            }
          ]
        }
      ]
    },
    "_end": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "trailing_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_suffix"
        }
      ]
    },
    "_suffix": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "ignored_suffix"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "ignored_suffix": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_ignored_start"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "ignored_text"
              },
              {
                "type": "FIELD",
                "name": "issue",
                "content": {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_invalid_encoding_issue"
                  },
                  "named": true,
                  "value": "syntax_issue"
                }
              }
            ]
          }
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment_marker"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comment_text"
              },
              {
                "type": "FIELD",
                "name": "issue",
                "content": {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_invalid_encoding_issue"
                  },
                  "named": true,
                  "value": "syntax_issue"
                }
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_suffix"
        }
      ]
    },
    "pattern": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_pattern_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "negation",
              "content": {
                "type": "SYMBOL",
                "name": "negation"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "glob_literal"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_glob_start"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "wildcard"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "recursive_wildcard"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "single_character"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "path_separator"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "escape"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "character_set"
                      },
                      {
                        "type": "FIELD",
                        "name": "issue",
                        "content": {
                          "type": "ALIAS",
                          "content": {
                            "type": "SYMBOL",
                            "name": "_invalid_encoding_issue"
                          },
                          "named": true,
                          "value": "syntax_issue"
                        }
                      },
                      {
                        "type": "FIELD",
                        "name": "issue",
                        "content": {
                          "type": "ALIAS",
                          "content": {
                            "type": "SYMBOL",
                            "name": "_invalid_escape_issue"
                          },
                          "named": true,
                          "value": "syntax_issue"
                        }
                      },
                      {
                        "type": "FIELD",
                        "name": "issue",
                        "content": {
                          "type": "ALIAS",
                          "content": {
                            "type": "SYMBOL",
                            "name": "_incomplete_escape_issue"
                          },
                          "named": true,
                          "value": "syntax_issue"
                        }
                      },
                      {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "SYMBOL",
                            "name": "_escape_prefix"
                          },
                          {
                            "type": "FIELD",
                            "name": "issue",
                            "content": {
                              "type": "ALIAS",
                              "content": {
                                "type": "SYMBOL",
                                "name": "_invalid_encoding_issue"
                              },
                              "named": true,
                              "value": "syntax_issue"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_end"
        }
      ]
    },
    "glob_literal": {
      "type": "SYMBOL",
      "name": "_literal"
    },
    "character_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "set_open"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "negation",
              "content": {
                "type": "SYMBOL",
                "name": "set_negation"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_set_item_start"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "set_text"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "escape"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "character_range"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "character_class"
                  },
                  {
                    "type": "FIELD",
                    "name": "issue",
                    "content": {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "_invalid_encoding_issue"
                      },
                      "named": true,
                      "value": "syntax_issue"
                    }
                  },
                  {
                    "type": "FIELD",
                    "name": "issue",
                    "content": {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "_invalid_escape_issue"
                      },
                      "named": true,
                      "value": "syntax_issue"
                    }
                  },
                  {
                    "type": "FIELD",
                    "name": "issue",
                    "content": {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "_incomplete_escape_issue"
                      },
                      "named": true,
                      "value": "syntax_issue"
                    }
                  },
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_escape_prefix"
                      },
                      {
                        "type": "FIELD",
                        "name": "issue",
                        "content": {
                          "type": "ALIAS",
                          "content": {
                            "type": "SYMBOL",
                            "name": "_invalid_encoding_issue"
                          },
                          "named": true,
                          "value": "syntax_issue"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "closing",
              "content": {
                "type": "SYMBOL",
                "name": "set_close"
              }
            },
            {
              "type": "FIELD",
              "name": "issue",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_missing_set_close_issue"
                },
                "named": true,
                "value": "syntax_issue"
              }
            },
            {
              "type": "FIELD",
              "name": "issue",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_incomplete_set_close_issue"
                },
                "named": true,
                "value": "syntax_issue"
              }
            }
          ]
        }
      ]
    },
    "character_range": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_range_start"
        },
        {
          "type": "FIELD",
          "name": "lower",
          "content": {
            "type": "SYMBOL",
            "name": "_endpoint"
          }
        },
        {
          "type": "SYMBOL",
          "name": "range_operator"
        },
        {
          "type": "FIELD",
          "name": "upper",
          "content": {
            "type": "SYMBOL",
            "name": "_endpoint"
          }
        }
      ]
    },
    "_endpoint": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "range_character"
        },
        {
          "type": "SYMBOL",
          "name": "escape"
        }
      ]
    },
    "character_class": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_compound_open"
          },
          "named": false,
          "value": "["
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_class_open"
          },
          "named": false,
          "value": ":"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "name",
                "content": {
                  "type": "SYMBOL",
                  "name": "class_name"
                }
              },
              {
                "type": "FIELD",
                "name": "issue",
                "content": {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_invalid_encoding_issue"
                  },
                  "named": true,
                  "value": "syntax_issue"
                }
              }
            ]
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_class_close"
          },
          "named": false,
          "value": ":"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_compound_close"
          },
          "named": false,
          "value": "]"
        }
      ]
    },
    "_missing_set_close_outcome": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_missing_set_close"
      },
      "named": true,
      "value": "missing_set_close"
    },
    "_missing_set_close_issue": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_missing_set_close_outcome"
      },
      "named": true,
      "value": "invalid_syntax"
    },
    "_incomplete_set_close_outcome": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_incomplete_set_close"
      },
      "named": true,
      "value": "missing_set_close"
    },
    "_incomplete_set_close_issue": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_incomplete_set_close_outcome"
      },
      "named": true,
      "value": "incomplete_syntax"
    },
    "_invalid_encoding_outcome": {
      "type": "ALIAS",
